<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Usuários - Euroart</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="auth.js"></script>
    <script>
        const user = JSON.parse(localStorage.getItem('usuario') || '{}');
        if (user.perfil !== 'admin') window.location.href = 'index.html';
    </script>
</head>
<body>
    <div class="app-layout">
        <main class="main-content">
            <div class="container" style="margin: 0; max-width: 100%;">
                <h1><i class="fas fa-users-cog"></i> Gestão de Usuários</h1>
                <p>Cadastre, edite perfis e gerencie as senhas de acesso do sistema.</p>
                
                <div id="feedbackMessage" class="feedback-message"></div>

                <!-- Formulário de Usuário -->
                <div class="container" style="margin-bottom: 30px; background-color: #f8fafc;">
                    <h2 id="form-titulo">Novo Usuário</h2>
                    <form id="form-usuario" style="display: flex; flex-direction: column; gap: 15px;">
                        <input type="hidden" id="usuarioId">
                        
                        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                            <input type="text" id="nomeInput" placeholder="Nome Completo" required style="flex: 2;">
                            <input type="email" id="emailInput" placeholder="E-mail de Acesso" required style="flex: 2;">
                            <select id="perfilInput" required style="flex: 1;">
                                <option value="conferente">Conferente</option>
                                <option value="admin">Administrador</option>
                            </select>
                        </div>

                        <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
                            <input type="password" id="senhaInput" placeholder="Senha (deixe em branco para manter a atual na edição)" style="flex: 1;">
                            <button type="submit" id="btnSalvarUsuario" class="btn-finalizar">
                                <i class="fas fa-save"></i> Salvar Usuário
                            </button>
                            <button type="button" id="btnCancelarEdicao" onclick="limparFormulario()" class="btn-pendentes" style="display: none;">
                                Cancelar Edição
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Tabela de Usuários -->
                <h2>Usuários Cadastrados</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Perfil</th>
                                <th>Data Cadastro</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabelaUsuarios"></tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script src="utils.js"></script>
    <script src="menu.js"></script>
    <script src="frases.js"></script>
    <script>
        carregarMenu('menu-usuarios');
        const token = localStorage.getItem('token');

        async function carregarUsuarios() {
            try {
                const res = await fetch('http://localhost:3000/api/usuarios', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const usuarios = await res.json();

                const tbody = document.getElementById('tabelaUsuarios');
                tbody.innerHTML = '';

                usuarios.forEach(u => {
                    const dataFormatada = new Date(u.criado_em).toLocaleDateString('pt-BR');
                    tbody.innerHTML += `
                        <tr>
                            <td>#${u.id}</td>
                            <td><strong>${u.nome}</strong></td>
                            <td>${u.email}</td>
                            <td><span class="user-cargo" style="color:#0f172a;">${u.perfil}</span></td>
                            <td>${dataFormatada}</td>
                            <td>
                                <button class="btn-retomar" onclick='prepararEdicao(${JSON.stringify(u)})' style="padding: 6px 12px; font-size: 0.85em;">
                                    <i class="fas fa-edit"></i> Editar
                                </button>
                                <button class="btn-excluir" onclick="excluirUsuario(${u.id})" style="padding: 6px 12px; font-size: 0.85em;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
            } catch (err) {
                mostrarMensagem("Erro ao carregar lista de usuários.", "error");
            }
        }

        function prepararEdicao(usuario) {
            document.getElementById('usuarioId').value = usuario.id;
            document.getElementById('nomeInput').value = usuario.nome;
            document.getElementById('emailInput').value = usuario.email;
            document.getElementById('perfilInput').value = usuario.perfil;
            document.getElementById('senhaInput').value = '';
            
            document.getElementById('form-titulo').textContent = `Editar Usuário #${usuario.id}`;
            document.getElementById('btnCancelarEdicao').style.display = 'inline-block';
            document.getElementById('senhaInput').placeholder = "Nova Senha (deixe em branco se não quiser alterar)";
        }

        function limparFormulario() {
            document.getElementById('usuarioId').value = '';
            document.getElementById('form-usuario').reset();
            document.getElementById('form-titulo').textContent = 'Novo Usuário';
            document.getElementById('btnCancelarEdicao').style.display = 'none';
            document.getElementById('senhaInput').placeholder = "Senha Temporária";
        }

        document.getElementById('form-usuario').addEventListener('submit', async (e) => {
            e.preventDefault();

            const id = document.getElementById('usuarioId').value;
            const nome = document.getElementById('nomeInput').value;
            const email = document.getElementById('emailInput').value;
            const perfil = document.getElementById('perfilInput').value;
            const novaSenha = document.getElementById('senhaInput').value;

            const isEdicao = Boolean(id);
            const url = isEdicao ? `http://localhost:3000/api/usuarios/${id}` : 'http://localhost:3000/api/auth/registrar';
            const method = isEdicao ? 'PUT' : 'POST';

            const body = isEdicao 
                ? { nome, email, perfil, ...(novaSenha ? { novaSenha } : {}) }
                : { nome, email, perfil, senha: novaSenha };

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}` 
                    },
                    body: JSON.stringify(body)
                });

                const data = await res.json();
                if (!res.ok) { mostrarMensagem(data.erro || "Erro na operação.", "error"); return; }

                mostrarMensagem(isEdicao ? "Usuário atualizado com sucesso!" : "Usuário cadastrado com sucesso!", "success");
                limparFormulario();
                carregarUsuarios();
            } catch (err) {
                mostrarMensagem("Erro de conexão com o servidor.", "error");
            }
        });

        async function excluirUsuario(id) {
            if (!confirm("Tem certeza que deseja excluir este usuário?")) return;

            try {
                const res = await fetch(`http://localhost:3000/api/usuarios/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                const data = await res.json();
                if (!res.ok) { mostrarMensagem(data.erro || "Erro ao excluir.", "error"); return; }

                mostrarMensagem("Usuário excluído com sucesso!", "success");
                carregarUsuarios();
            } catch (err) {
                mostrarMensagem("Erro ao excluir usuário.", "error");
            }
        }

        carregarUsuarios();
    </script>
</body>
</html>